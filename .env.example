# ── Investment simulator (Turso / libSQL + Drizzle) ──────────────────────────
# Turso database URL. In production use a libsql:// URL from your Turso database.
# For local dev, leave unset (or use file:local.db) to fall back to a local
# SQLite file — the app works with zero setup.
TURSO_DATABASE_URL=libsql://your-database.turso.io

# Turso auth token (required for a remote libsql:// URL, omit for the local file).
TURSO_AUTH_TOKEN=

# Comma-separated Privy DIDs that are granted the "admin" role on first login
# (admin bootstrap). The DID comes from the verified access token, so it cannot
# be spoofed. Example: did:privy:abc123,did:privy:def456
SIMULATOR_ADMIN_DIDS=
